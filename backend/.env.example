# Backend + worker environment template.
# Copy to backend/.env (and worker/.env, unchanged) and fill in OLLAMA_API_KEY.
# See ../.env.example for the shared, full template and ../README.md for setup steps.

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=wayam_testing_cloud
JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=1440
DEMO_MODE=true
REDIS_URL=redis://localhost:6379

# AI
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud
